# Leave VITE_API_BASE empty to use same-origin relative URLs.
#   - dev:    vite proxies /api -> http://localhost:8000 (see vite.config.ts)
#   - docker: nginx proxies /api -> backend:8000 (see nginx.conf)
# Set it only if your backend lives on a different origin, e.g.:
#   VITE_API_BASE=http://localhost:8000
VITE_API_BASE=
