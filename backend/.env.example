# Copy to .env and fill in. All values are optional — with no keys the app
# runs in deterministic MOCK mode so you can demo the full pipeline offline.

# OpenAI — required for live GPT-4o / GPT-4o-mini output.
# If unset, the backend streams a deterministic mock response instead.
OPENAI_API_KEY=

# Tavily — optional. If set, the Researcher does real web search.
# If unset, the Researcher returns static mock search results.
TAVILY_API_KEY=

# Force mock mode even if OPENAI_API_KEY is set (useful for demos/tests).
USE_MOCK_LLM=false

# Default model when the client doesn't specify one.
DEFAULT_MODEL=gpt-4o-mini

# SQLite location (file is created on first run).
DATABASE_URL=sqlite:///./agentforge.db

# Comma-separated list of allowed CORS origins (the Vite dev server, etc.).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
